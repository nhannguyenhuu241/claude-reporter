# SQLite database file
# Path is relative to prisma/schema.prisma, so this creates web/prisma/claude-reporter.db
DATABASE_URL="file:./claude-reporter.db"

# Port for the web server
PORT=3005

# Optional: shared secret so only Claude hooks can POST events
# HOOK_SECRET=your-secret-here

# Optional: machine identifier (useful for multi-machine setups)
# MACHINE_ID=my-macbook
